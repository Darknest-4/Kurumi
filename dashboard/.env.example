# Kurumi dashboard — environment
# Points at the SAME PostgreSQL the bot uses.
DATABASE_URL=postgresql://kurumi:kurumi@localhost:5432/kurumi?schema=public

# Login gate. Set a strong secret; it signs the session cookie.
DASHBOARD_SECRET=change-me-to-a-long-random-string
# Password required to log in to the dashboard.
DASHBOARD_PASSWORD=change-me
