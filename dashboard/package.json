{
  "name": "kurumi-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Kurumi — web dashboard (dark, anime-themed). Manages the same Postgres/Prisma data the bot uses.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
