# ─────────────────────────────────────────────────────────────
# Kurumi — Environment (BOOTSTRAP ONLY)
#
# IMPORTANT: This file holds ONLY the values needed to boot the
# process and connect to infrastructure. NO gameplay/economy values
# live here — XP rates, cooldowns, drop rates, boss HP, prices, colors,
# emojis, log channels, prefixes, etc. are ALL stored in the database
# and editable per-guild at runtime via the ConfigManager.
# ─────────────────────────────────────────────────────────────

# Discord
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
# Optional: register slash commands to a single guild for fast dev iteration
DEV_GUILD_ID=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://kurumi:kurumi@localhost:5432/kurumi?schema=public

# Redis (cache, cooldowns, pub/sub, event state)
REDIS_URL=redis://localhost:6379

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# Sharding (leave 'auto' to let discord.js decide; used at scale)
SHARD_COUNT=auto

# Bootstrap owner(s) — comma separated Discord user IDs.
# These are the ONLY hardcoded developers; they can promote others via DB at runtime.
BOOTSTRAP_OWNER_IDS=
